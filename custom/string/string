#pragma once

#include <stdio.h>
#include <string.h>
#include <stdarg.h>
#include <stdint.h>

namespace custom {

template<size_t N>
class string {
private:
    // static constexpr size_t N = 64;
    char data_[N];

public:
    string() {
        memset(data_, 0, N);
    }

    string(const char *string) {
        strncpy(data_, string, N - 1);
        data_[N - 1] = '\0';
    }

    string(const char *fmt, ...) {
        memset(data_, 0, N); 
        va_list args; 
        va_start(args, fmt);
        vsnprintf(data_, N, fmt, args);
        va_end(args);
    }

    string(const uint8_t *const data, size_t size) {
        size_t copy_size = N - 1 > size ? size : N - 1;
        memcpy(data_, data, N > size ? size : N);
        data_[copy_size] = '\0';
    }

    ~string() = default;

    size_t length() { return strlen(data_); }
    constexpr size_t size() const { return N; }
    char *c_str() { return data_; }
    uint8_t *data() { return (uint8_t *)data_; }

    string &operator=(const char *other) {
        strncpy(data_, other, N - 1);
        data_[N - 1] = '\0';
        return *this;
    }

    string &operator+=(const char *other) {
        strncat(data_, other, N - length() - 1);
        return *this;
    }

    string &operator+=(char other) {
        size_t len = length();
        if (len < N - 1) {
            data_[len] = other;
            data_[len + 1] = '\0';
        }
        return *this;
    }
};

class string_util {
public:
    static constexpr char hex_to_char(uint8_t hex) {
        return hex < 10 ? '0' + hex : 'A' + (hex - 10);
    }

    static constexpr char decimal_to_char(uint8_t dec) {
        return '0' + dec;
    }

    static constexpr uint8_t to_number(char hex) {
        if ('0' <= hex && hex <= '9') {
            return hex - '0'; 
        } else if ('A' <= hex && hex <= 'F') {
            return hex - 'A' + 10;
        } else if ('a' <= hex && hex <= 'f') {
            return hex - 'a' + 10;
        } else {
            return 0;
        }
    }

    static constexpr void to_hex_string(const uint8_t *src, size_t src_size, char *dest, size_t dest_size) {
        size_t min = (src_size * 2 + 1 > dest_size) ? (dest_size - 1) / 2 : src_size;
        for (size_t i = 0; i < min; ++i) {
            *dest++ = hex_to_char(src[i] >> 4);
            *dest++ = hex_to_char(src[i] & 0xF);
        }
        *dest = '\0';
    }

    static constexpr void to_decimal_string(const uint8_t *src, size_t src_size, char *dest, size_t dest_size) {
        if (dest_size == 0) return;
        if (src == nullptr || src_size == 0) {
            dest[0] = '\0';
            return;
        }

        // Interpret buffer as a big-endian unsigned integer and format as decimal.
        // This matches typical protocol representations (e.g., port 8862 -> "8862").
        uint64_t value = 0;
        for (size_t i = 0; i < src_size; ++i) {
            value = (value << 8) | src[i];
        }

        // Convert to decimal string (max 20 digits for uint64_t).
        char tmp[21] = {0};
        size_t len = 0;
        if (value == 0) {
            tmp[len++] = '0';
        } else {
            while (value > 0 && len < sizeof(tmp) - 1) {
                tmp[len++] = '0' + (value % 10);
                value /= 10;
            }
        }

        // Reverse into destination buffer, respecting dest_size.
        size_t out_len = (len < dest_size - 1) ? len : dest_size - 1;
        for (size_t i = 0; i < out_len; ++i) {
            dest[i] = tmp[len - 1 - i];
        }
        dest[out_len] = '\0';
    }

};

};
