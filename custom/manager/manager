#pragma once

#include <string.h>
#include <custom>

namespace custom {

template<typename T, size_t N>
class manager {
public:
    manager() = default;

    manager(const T *p, size_t u, size_t offset = 0) {
        u_ = u > N ? N : u;
        memcpy(p_, p, u_ * sizeof(T));
    }

    constexpr size_t size() const { return N; }
    constexpr size_t usage() const { return u_; }

    T *begin() noexcept { return p_; }
    const T *begin() const noexcept { return p_; }
    T *end() noexcept { return p_ + u_; }
    const T *end() const noexcept { return p_ + u_; }
    T *data() noexcept { return p_; }
    const T *data() const noexcept { return p_; }
    void clear() { u_ = 0; offset_ = 0; }
    bool empty() const { return u_ == 0; }

    T &next() {
        if (u_ < N) {
            ++u_;
        }
        if (offset_ >= N) {
            offset_ = 0;
        }
        return p_[offset_++];
    }

    void remove(const size_t position) {
        if (position >= u_) {
            return;
        }

        for (size_t i = position; i < u_ - 1; ++i) {
            p_[i] = p_[i + 1];
        }

        p_[u_ - 1] = T{};
        --u_;
    }

    void remove(const T &object) {

        size_t position = custom::find(p_, N, object);

        remove(position);
    }


    T &operator[](size_t offset) {
        return p_[offset];
    }

private:
    T p_[N]{};
    size_t u_ = 0;
    size_t offset_ = 0;
};

template<typename T1, typename T2>
struct pair {
    T1 first;
    T2 second;
};

};
