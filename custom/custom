#pragma once

#include <stddef.h>

namespace custom {

    template<typename T>
    static constexpr T dummy = T{};

    template<typename T>
    size_t find(const T *const buffer, size_t size, const T *const data) {

        if (data == nullptr || buffer == nullptr || size == 0) {
            return -1;
        }

        size_t location = 0;
        bool is_find = false;

        for (; location < size; ++location) {
            if (&buffer[location] == data) {
                is_find = true;
                break;
            }
        }

        if (!is_find) {
            location = -1;
        }

        return location;
    }

    template<typename T>
    size_t find(const T *const buffer, size_t size, const T &data) {

        if (buffer == nullptr || size == 0) {
            return size;
        }

        for (size_t i = 0; i < size; ++i) {
            if (buffer[i] == data) {
                return i;
            }
        }

        return size;
    }

    template<typename T>
    static constexpr T min(T a, T b) {
        return a > b ? b : a;
    }

    template<typename T>
    static constexpr T max(T a, T b) {
        return a > b ? a : b;
    }

    template<typename T>
    static constexpr T abs(T value) {
        return value < 0 ? -value : value;
    }

    template<typename T>
    static constexpr size_t array_length(const T &array) {
        return sizeof(array) / sizeof(array[0]);
    }

    template<typename UnsignedType>
    static constexpr UnsignedType subtract(UnsignedType a, UnsignedType b) {
        return a >= b ? a - b : 0;
    }

};
